{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unknown-scraper",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unknown-events",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "vars": {
    "IMAGE_PUBLIC_BASE_URL": "https://unknown-scraper.YOUR_SUBDOMAIN.workers.dev"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "EVENT_IMAGES_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
