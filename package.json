{
  "name": "unknown",
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "storybook": "turbo run storybook --filter=@repo/ui",
    "build-storybook": "turbo run build-storybook --filter=@repo/ui",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dev:vinext": "bun run --cwd apps/web dev:vinext",
    "build:vinext": "bun run --cwd apps/web build",
    "start:vinext": "bun run --cwd apps/web start:vinext",
    "deploy:vinext": "bun run --cwd apps/web deploy",
    "deploy": "bun run --cwd apps/web deploy"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module"
}
